# Realworks Wonen v3 API token (rwauth-schema). Op te vragen bij Realworks.
REALWORKS_API_TOKEN=

# Optioneel: static-IP egress proxy voor een vast uitgaand IP (productie op Vercel).
# Vercel-functies hebben geen vast IP; route de Realworks-calls via een proxy
# met vast IP en whitelist dat IP (/32) bij Realworks.
# REALWORKS_PROXY_URL=http://user:pass@proxy-host:poort

# Move.nl bezichtigingsplanner widget-token (per mail van Realworks na activatie
# in de Marketplace). Staat by-design in de client-HTML, dus NEXT_PUBLIC_.
# De department_id en object_id komen uit de Wonen API (afdelingscode resp. id).
NEXT_PUBLIC_VIEWINGPLANNER_WIDGET_TOKEN=
