# Realworks Wonen v3 API token (rwauth-schema). Op te vragen bij Realworks.
REALWORKS_API_TOKEN=

# Optioneel: static-IP egress proxy voor een vast uitgaand IP (productie op Vercel).
# Vercel-functies hebben geen vast IP; route de Realworks-calls via een proxy
# met vast IP en whitelist dat IP (/32) bij Realworks.
# REALWORKS_PROXY_URL=http://user:pass@proxy-host:poort

# Move.nl bezichtigingsplanner widget-token (per mail van Realworks na activatie
# in de Marketplace). Staat by-design in de client-HTML, dus NEXT_PUBLIC_.
# De department_id en object_id komen uit de Wonen API (afdelingscode resp. id).
NEXT_PUBLIC_VIEWINGPLANNER_WIDGET_TOKEN=

# ---- CMS (admin + backend, api/index.py) ----
# Vaste Flask-sessiesleutel. ZONDER deze logt de admin in een redirect-loop op
# serverless: elke instance genereert anders zijn eigen secret.
# Genereer: python3 -c "import secrets;print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Admin-wachtwoord: zet ALLEEN de hash, nooit het wachtwoord zelf.
# Genereer met scripts/admin-wachtwoord.py. ADMIN_PASSWORD blijft leeg —
# een ontbrekende env-var mag geen open admin geven.
ADMIN_PASS_HASH=
ADMIN_PASSWORD=

# KV-store (productie). Turso heeft voorrang op Supabase.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Media-uploads
BLOB_READ_WRITE_TOKEN=

# Centrale MAIHS-gateway (AI, mail, Google-SSO). URL is een KALE origin.
MHS_GATEWAY_URL=
MHS_GATEWAY_KEY=
